{
  "name": "terp",
  "version": "1.0.0",
  "description": "ターミナルを複数開いて素早く切り替える macOS 用の端末アプリ",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "TERP_SELFTEST=${TERP_SELFTEST:-/tmp/terp-selftest} electron .",
    "postinstall": "node node_modules/electron/install.js && chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper",
    "dist": "electron-builder --mac dir",
    "install-app": "npm run dist && codesign --force --deep -s - dist/mac-arm64/terp.app && rm -rf /Applications/terp.app && ditto dist/mac-arm64/terp.app /Applications/terp.app",
    "link-app": "scripts/link-app.sh",
    "make-icon": "electron scripts/make-icon.js"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "koffi": "^3.3.3",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "build": {
    "appId": "local.terp",
    "productName": "terp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/koffi/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.icns"
    }
  }
}
